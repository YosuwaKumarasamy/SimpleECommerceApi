        "required": [
          "Category",
          "Name"
        ],
        "type": "object",
        "properties": {
          "Name": {
            "minLength": 1,
            "type": "string"
          },
          "Description": {
            "type": "string",
            "nullable": true
          },
          "Category": {
            "minLength": 1,
            "type": "string"
          },
          "Price": {
            "maximum": 100000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "Stock": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
