          },
          "Category": {
            "minLength": 1,
            "type": "string"
          },
          "Price": {
            "maximum": 100000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "Stock": {
            "maximum": 1000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
